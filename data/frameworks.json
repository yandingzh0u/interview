{
  "version": 10,
  "updatedAt": "2026-11-01",
  "note": "5 个一级 Tag × 13 个二级 Tag。二级 subtypes.labels 是这道题必须交出来的东西（怎么讲），不是思考顺序。aliases 记录改过的旧名字，载入时自动对齐，不用手动改题库。",
  "categories": [
    {
      "id": "解释原理",
      "aliases": {
        "是什么": "概念与作用",
        "为什么这样": "原因机制",
        "有哪些": "分类与组成",
        "怎么工作": "工作流程",
        "工作过程": "工作流程"
      },
      "subtypes": [
        {
          "id": "概念与作用",
          "labels": [
            "核心概括",
            "补充说明"
          ],
          "focus": "交付「它是什么、有什么用」。第一段一句话说清是什么、或者核心作用是什么就够了；题目需要展开时，第二段再补关键特征、解决的问题或适用场景。第二段按需，简单题只填第一段。"
        },
        {
          "id": "原因机制",
          "labels": [
            "结论",
            "原因",
            "机制"
          ],
          "focus": "交付「为什么会这样」。主语是技术设计本身：先给结论，再讲为什么，最后说清中间到底发生了什么。和「故障归因」的区别看主语——讲设计为什么长这样走这里，讲运行中的系统为什么坏了走故障归因。"
        },
        {
          "id": "分类与组成",
          "labels": [
            "分类依据",
            "主要类别及特点"
          ],
          "focus": "交付「有哪些类型、由什么组成」。先给分类维度，再逐类一句话点差异，不逐个深挖。问「怎么规避 / 怎么设计」的题目不属于这里，那要交出方案，走「如何设计」。"
        },
        {
          "id": "工作流程",
          "labels": [
            "总览",
            "分阶段展开"
          ],
          "focus": "交付「整个过程怎么运行」。先用一句话说清整条链路，再按时间顺序、调用顺序或数据流展开实际步骤。不强制单独写输入、状态变化、局限，必要时自然融进阶段里。"
        }
      ]
    },
    {
      "id": "对比选型",
      "aliases": {
        "为什么选A": "怎么选",
        "选型理由": "怎么选"
      },
      "subtypes": [
        {
          "id": "有什么区别",
          "labels": [
            "比较维度",
            "核心差异",
            "结论"
          ],
          "focus": "交付「A 和 B 差在哪」。先立比较维度，再逐维对比，最后给一句能记住的结论。没有既定答案、不需要替谁辩解，只是讲差异。"
        },
        {
          "id": "怎么选",
          "labels": [
            "判断条件",
            "匹配与代价",
            "什么情况选它"
          ],
          "focus": "交付「选哪个、为什么不用另一个」。已经有方案在用时也一样走这里：先说清判断条件，再逐项匹配并点明各自代价（含原方案的缺口），最后说什么情况下选它、什么情况下别选。"
        }
      ]
    },
    {
      "id": "设计实现",
      "aliases": {
        "怎么实现": "如何设计"
      },
      "subtypes": [
        {
          "id": "如何设计",
          "labels": [
            "目标约束",
            "核心方案",
            "执行流程"
          ],
          "focus": "交付「怎么造出来」。三段就够：为什么这么设计（要解决什么、有什么限制）、由什么组成（模块、数据结构、关键技术，每个一句话说清负责什么）、怎么跑起来（模块之间怎么配合、调用顺序怎样）。异常处理、性能优化、验证测试不是必答步骤，面试官追问时再展开。"
        },
        {
          "id": "怎么落地",
          "labels": [
            "环境与依赖",
            "接入与灰度",
            "监控与回滚"
          ],
          "focus": "交付「怎么上线并保证生产可用」。不重讲设计：先讲真实环境、权限、依赖和资源约束，再讲怎么接入、怎么灰度放量，最后讲监控看什么指标、出问题怎么回滚。"
        }
      ]
    },
    {
      "id": "排障治理",
      "aliases": {
        "为什么出错": "故障归因",
        "怎么排查": "怎么定位"
      },
      "subtypes": [
        {
          "id": "故障归因",
          "labels": [
            "现象",
            "原因分类",
            "触发条件"
          ],
          "focus": "交付「为什么坏」。主语是运行中的系统出了状况：先说清现象，再把可能原因分类列全，最后说每类原因在什么条件下会触发。不需要展开排查过程，那是「怎么定位」。"
        },
        {
          "id": "怎么定位",
          "labels": [
            "从哪查",
            "排查路径",
            "证据",
            "根因"
          ],
          "focus": "交付「怎么查到根因」。先说从哪几个方向查（分层或分链路），再给排查顺序，每一步说清看什么证据，最后落到根因。归因是定位的产物，不用单独再讲一遍。"
        },
        {
          "id": "怎么处理",
          "labels": [
            "止血",
            "根因修复",
            "验证与预防"
          ],
          "focus": "交付「怎么修、怎么防」。先止血（降级、切流、回滚），再修根因；有副作用的改动要说清怎么验证、怎么防复发。"
        }
      ]
    },
    {
      "id": "评测优化",
      "aliases": {
        "指标怎么设计": "怎么评估"
      },
      "subtypes": [
        {
          "id": "怎么评估",
          "labels": [
            "目标与评测范围",
            "评测集",
            "指标与阈值",
            "评测方法",
            "结果分析"
          ],
          "focus": "交付「好不好」。指标设计是这道题的第 3 段，不单独开一套：先说清评什么、评到哪一层，再说评测集怎么来（数据来源、规模、覆盖），然后是每个指标怎么定义、阈值怎么定，接着是跑的方法（离线、在线、人工），最后怎么解读结果。"
        },
        {
          "id": "如何优化",
          "labels": [
            "基线",
            "瓶颈",
            "改进",
            "对照验证"
          ],
          "focus": "交付「怎么变好」。从基线说到瓶颈，再给改进动作，最后用对照实验证明收益。"
        }
      ]
    }
  ]
}
